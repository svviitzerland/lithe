{
  "name": "@lithe/ssh",
  "version": "0.1.0",
  "description": "An SSH-2 server in pure TypeScript, built on WebCrypto. Runs inside a serverless function.",
  "keywords": ["ssh", "ssh2", "webcrypto", "serverless", "workers", "edge", "tui"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lithe-sh/lithe.git", "directory": "packages/ssh" },
  "homepage": "https://github.com/lithe-sh/lithe#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "bun": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "src", "README.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": { "build": "tsc -p tsconfig.build.json" }
}
