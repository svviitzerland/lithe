    { "in": "A", "out": [{ "t": "key", "key": "A", "rune": "A" }] },
    { "in": " ", "out": [{ "t": "key", "key": "space", "rune": " " }] },
    { "in": "\u0003", "out": [{ "t": "key", "key": "ctrl+c" }] },
    { "in": "\u0001", "out": [{ "t": "key", "key": "ctrl+a" }] },
    { "in": "\r", "out": [{ "t": "key", "key": "enter" }] },
    { "in": "\t", "out": [{ "t": "key", "key": "tab" }] },
    { "in": "\u007f", "out": [{ "t": "key", "key": "backspace" }] },
