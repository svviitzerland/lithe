    { "in": "\u001b[15~", "out": [{ "t": "key", "key": "f5" }] },
    { "in": "\u001bOP", "out": [{ "t": "key", "key": "f1" }] },
    { "in": "\u001b[1;5A", "out": [{ "t": "key", "key": "ctrl+up" }] },
