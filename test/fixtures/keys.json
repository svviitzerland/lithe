    { "in": "日", "out": [{ "t": "key", "key": "日", "rune": "日" }] },
    { "in": "j\u001b[Bq", "out": [{ "t": "key", "key": "j", "rune": "j" }, { "t": "key", "key": "down" }, { "t": "key", "key": "q", "rune": "q" }] }
  ]
