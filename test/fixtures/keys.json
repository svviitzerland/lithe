    { "in": "\u001b[C", "out": [{ "t": "key", "key": "right" }] },
    { "in": "\u001b[D", "out": [{ "t": "key", "key": "left" }] },
    { "in": "\u001b[Z", "out": [{ "t": "key", "key": "shift+tab" }] },
    { "in": "\u001b[H", "out": [{ "t": "key", "key": "home" }] },
    { "in": "\u001b[3~", "out": [{ "t": "key", "key": "delete" }] },
